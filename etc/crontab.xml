<!--
The minute job is the only one that runs catalog checks; the scheduled job asks for one at the time set in the
settings, read from the path its backend model writes, with a default that ships in config.xml.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="hryvinskyi_rich_snippets">
        <job name="hryvinskyi_rich_snippets_run_requested" instance="Hryvinskyi\RichSnippets\Cron\RunRequestedCheck"
             method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="hryvinskyi_rich_snippets_schedule_check" instance="Hryvinskyi\RichSnippets\Cron\ScheduleCheck"
             method="execute">
            <config_path>crontab/hryvinskyi_rich_snippets/jobs/hryvinskyi_rich_snippets_schedule_check/schedule/cron_expr</config_path>
        </job>
        <job name="hryvinskyi_rich_snippets_prune" instance="Hryvinskyi\RichSnippets\Cron\PruneCheckData"
             method="execute">
            <schedule>45 4 * * *</schedule>
        </job>
    </group>
</config>
