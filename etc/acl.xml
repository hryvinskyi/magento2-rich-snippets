<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::marketing">
                    <resource id="Magento_Backend::marketing_seo">
                        <resource id="Hryvinskyi_RichSnippets::view" title="See the module" translate="title" sortOrder="50">
                            <resource id="Hryvinskyi_RichSnippets::snippets" title="Change snippets" translate="title" sortOrder="10"/>
                            <resource id="Hryvinskyi_RichSnippets::test" title="Run tests" translate="title" sortOrder="20"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Hryvinskyi_RichSnippets::config" title="Change the settings" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
