{
    "name": "product",
    "description": "The Product template of the library, as the builder prints it",
    "projection": "tree",
    "template": "{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"{{product.name}}\",\n  \"description\": \"{{product.short_description | plain | limit:5000}}\",\n  \"sku\": \"{{product.sku}}\",\n  \"gtin13\": \"{{product.ean}}\",\n  \"image\": {\n    \"@each\": \"product.gallery\",\n    \"@value\": \"{{image.url}}\"\n  },\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"name\": \"{{product.manufacturer | default:'Linden & Co.'}}\"\n  },\n  \"color\": \"{{product.color}}\",\n  \"offers\": {\n    \"@type\": \"Offer\",\n    \"url\": \"{{product.url}}\",\n    \"price\": \"{{product.final_price}}\",\n    \"priceCurrency\": \"{{store.currency}}\",\n    \"priceValidUntil\": \"{{product.special_to_date}}\",\n    \"priceSpecification\": {\n      \"@if\": \"product.on_sale\",\n      \"@type\": \"UnitPriceSpecification\",\n      \"priceType\": \"https://schema.org/StrikethroughPrice\",\n      \"price\": \"{{product.regular_price}}\",\n      \"priceCurrency\": \"{{store.currency}}\"\n    },\n    \"availability\": \"{{product.availability}}\",\n    \"itemCondition\": \"https://schema.org/NewCondition\",\n    \"hasMerchantReturnPolicy\": { \"@include\": \"return-policy\" }\n  },\n  \"aggregateRating\": {\n    \"@type\": \"AggregateRating\",\n    \"ratingValue\": \"{{reviews.rating}}\",\n    \"reviewCount\": \"{{reviews.count}}\"\n  },\n  \"review\": {\n    \"@each\": \"reviews.latest\",\n    \"@limit\": 3,\n    \"@type\": \"Review\",\n    \"author\": {\n      \"@type\": \"Person\",\n      \"name\": \"{{review.nickname}}\"\n    },\n    \"datePublished\": \"{{review.date}}\",\n    \"reviewBody\": \"{{review.text}}\",\n    \"reviewRating\": {\n      \"@type\": \"Rating\",\n      \"ratingValue\": \"{{review.rating}}\"\n    }\n  }\n}",
    "printed": "{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"{{product.name}}\",\n  \"description\": \"{{product.short_description | plain | limit:5000}}\",\n  \"sku\": \"{{product.sku}}\",\n  \"gtin13\": \"{{product.ean}}\",\n  \"image\": {\n    \"@each\": \"product.gallery\",\n    \"@value\": \"{{image.url}}\"\n  },\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"name\": \"{{product.manufacturer | default:'Linden & Co.'}}\"\n  },\n  \"color\": \"{{product.color}}\",\n  \"offers\": {\n    \"@type\": \"Offer\",\n    \"url\": \"{{product.url}}\",\n    \"price\": \"{{product.final_price}}\",\n    \"priceCurrency\": \"{{store.currency}}\",\n    \"priceValidUntil\": \"{{product.special_to_date}}\",\n    \"priceSpecification\": {\n      \"@if\": \"product.on_sale\",\n      \"@type\": \"UnitPriceSpecification\",\n      \"priceType\": \"https://schema.org/StrikethroughPrice\",\n      \"price\": \"{{product.regular_price}}\",\n      \"priceCurrency\": \"{{store.currency}}\"\n    },\n    \"availability\": \"{{product.availability}}\",\n    \"itemCondition\": \"https://schema.org/NewCondition\",\n    \"hasMerchantReturnPolicy\": { \"@include\": \"return-policy\" }\n  },\n  \"aggregateRating\": {\n    \"@type\": \"AggregateRating\",\n    \"ratingValue\": \"{{reviews.rating}}\",\n    \"reviewCount\": \"{{reviews.count}}\"\n  },\n  \"review\": {\n    \"@each\": \"reviews.latest\",\n    \"@limit\": 3,\n    \"@type\": \"Review\",\n    \"author\": {\n      \"@type\": \"Person\",\n      \"name\": \"{{review.nickname}}\"\n    },\n    \"datePublished\": \"{{review.date}}\",\n    \"reviewBody\": \"{{review.text}}\",\n    \"reviewRating\": {\n      \"@type\": \"Rating\",\n      \"ratingValue\": \"{{review.rating}}\"\n    }\n  }\n}",
    "rows": [
