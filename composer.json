{
    "name": "hryvinskyi/magento2-rich-snippets",
    "description": "Rich snippets for Magento 2: JSON-LD blocks written as templates, placed by kind of page, condition and store view, with Google's requirements checked in the admin, a page test and a nightly catalog check",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "hryvinskyi/magento2-admin-setup-wizard": "^1.0",
        "hryvinskyi/magento2-admin-ui": "^1.3",
        "hryvinskyi/magento2-base": "^3.0",
        "hryvinskyi/magento2-head-tag-manager": "^4.0",
        "hryvinskyi/magento2-json-template": "^1.0",
        "hryvinskyi/magento2-ui-form-elements": "^1.3",
        "magento/framework": "*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-import-export": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-catalog-url-rewrite": "*",
        "magento/module-cms": "*",
        "magento/module-config": "*",
        "magento/module-configurable-product": "*",
        "magento/module-cron": "*",
        "magento/module-customer": "*",
        "magento/module-directory": "*",
        "magento/module-eav": "*",
        "magento/module-email": "*",
        "magento/module-import-export": "*",
        "magento/module-page-cache": "*",
        "magento/module-review": "*",
        "magento/module-store": "*",
        "magento/module-tax": "*",
        "magento/module-theme": "*",
        "magento/module-url-rewrite": "*",
        "psr/log": "^2 || ^3"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\RichSnippets\\": ""
        }
    }
}
